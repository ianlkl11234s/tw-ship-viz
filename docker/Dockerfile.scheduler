# 定時排程：自動從 S3 更新資料 + 產出 Arrow
FROM python:3.12-slim
WORKDIR /app

# 時區 + cron
ENV TZ=Asia/Taipei
RUN apt-get update && apt-get install -y --no-install-recommends cron tzdata \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY scripts/ ./scripts/
COPY data/ports.geojson data/taiwan_land.json ./geodata/

# data + arrow-data volumes
VOLUME ["/app/data", "/app/arrow-data"]

# cron 由 start script 動態建立（繼承環境變數）
COPY docker/scheduler-start.sh ./start.sh
RUN chmod +x start.sh

CMD ["./start.sh"]
